# Copie para .env e ajuste. O docker-compose carrega estas variaveis.

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=expense_identity
MYSQL_USER=expense
MYSQL_PASSWORD=change-me-app

# ---- Identity Service ----
IDENTITY_HTTP_PORT=5080
IDENTITY_ISSUER=http://localhost:5080
IDENTITY_SEED_ENABLED=true

# ---- Accounts Service ----
ACCOUNTS_HTTP_PORT=5090
ACCOUNTS_DB_ROOT_PASSWORD=change-me-root
ACCOUNTS_DB_NAME=expense_accounts
ACCOUNTS_DB_USER=expense
ACCOUNTS_DB_PASSWORD=change-me-app

# ---- Transactions Service ----
TRANSACTIONS_HTTP_PORT=5100
TRANSACTIONS_DB_ROOT_PASSWORD=change-me-root
TRANSACTIONS_DB_NAME=expense_transactions
TRANSACTIONS_DB_USER=expense
TRANSACTIONS_DB_PASSWORD=change-me-app

# ---- Gateway ----
GATEWAY_HTTP_PORT=8080

# ---- Web (SPA) ----
WEB_HTTP_PORT=5173
