# Configuracao do cliente OAuth da SPA (Vite expoe apenas variaveis com prefixo VITE_).
VITE_IDENTITY_AUTHORITY=http://localhost:5080
VITE_CLIENT_ID=expense-tracking-spa
VITE_REDIRECT_URI=http://localhost:5173/callback
VITE_SCOPE=openid profile expenses.read expenses.write offline_access
# Base das APIs de recurso (gateway). Ex.: http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080
