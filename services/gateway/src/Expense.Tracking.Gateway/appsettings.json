{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "http://localhost:5080",
    "MetadataAddress": "",
    "Audience": "expense-tracking-api"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "accounts-api": {
        "ClusterId": "accounts",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "accounts": {
        "Destinations": {
          "accounts-1": {
            "Address": "http://localhost:5090/"
          }
        }
      }
    }
  }
}
