{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ReportingDb": "server=localhost;port=3306;database=expense_reporting;user=root;password=root;"
  },
  "ServiceAuth": {
    "TokenEndpoint": "http://localhost:5080/oauth/token",
