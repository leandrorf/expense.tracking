    "Enabled": true,
    "BatchSize": 100,
    "PollIntervalSeconds": 2
  },
  "Jwt": {
    "Authority": "http://localhost:5080",
    "MetadataAddress": "",
    "Audience": "expense-tracking-api"
  },
  "Services": {
    "TransactionsBaseUrl": "http://localhost:5100",
    "AccountsBaseUrl": "http://localhost:5090"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
