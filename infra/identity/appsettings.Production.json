        "RequirePkce": false
      }
    },
    "Users": {
      "demo": {
        "Email": "demo@expense.local",
        "DisplayName": "Demo User"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
